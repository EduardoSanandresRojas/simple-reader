{
  "name": "simple-reader",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "description": "A clean, local-first EPUB and PDF reader with instant word lookup, Spanish translation and Japanese furigana.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node src/reader/e2e/run.mjs && node e2e/run-annotations.mjs",
    "tauri": "tauri",
    "budget": "node scripts/bundle-budget.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "playwright": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "kuromoji": "^0.1.2",
    "kuroshiro": "^1.2.1",
    "node-unrar-js": "^2.0.2",
    "pdfjs-dist": "^6.5.438"
  }
}
